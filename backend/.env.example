# =============================================================================
# SCM FLOW — BACKEND & SUPABASE DOCKER ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env on the internal server and replace placeholder values.
# NEVER commit real passwords, JWT secrets, or service-role keys to git.
# =============================================================================

# PostgreSQL Database Credentials
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-database-password

# Supabase JWT & API Keys (Server-side only — NEVER expose SERVICE_ROLE_KEY to frontend)
JWT_SECRET=replace-with-at-least-32-character-jwt-secret-key
JWT_EXPIRY=86400
ANON_KEY=replace-with-generated-supabase-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-supabase-service-role-jwt

# Application Network & Timezone
APP_URL=https://scm.company.internal
API_EXTERNAL_URL=https://scm.company.internal/api
TZ=Asia/Kolkata
DEFAULT_CURRENCY=INR
DELIVERY_REMINDER_DAYS=3

# Internal Corporate SMTP Relay (for Password Reset & 3-Day Delivery Reminders)
SMTP_HOST=smtp.company.internal
SMTP_PORT=587
SMTP_USER=scm-notifications@company.internal
SMTP_PASS=replace-with-smtp-password
SMTP_SENDER_NAME=SCM Flow Enterprise

